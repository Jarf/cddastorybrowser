	{% if story %}
	<div id="footer" role="navigation">
		<h1 id="storycategory">
			<a href="/story/{{story.categoryName}}" aria-label="View {{categoryname}} Story Index">{{categoryname}} {{storycount}}</a>
		</h1>
		<div id="storylinks">
			<a href="/story/{{story.prevstory}}" aria-label="View Previous Story">Prev</a>
			<a href="{{randomstory}}" aria-label="View a Random Story">Rand</a>
			<a href="/story/{{story.nextstory}}" aria-label="View Next Story">Next</a>
		</div>
	</div>
	{% elseif dialogue %}
	<div id="footer" role="navigation">
		<h1 id="storycategory">
			<a href="/dialogue/{{dialogue.factionCode}}/{{dialogue.npcCode}}" aria-label="View {{dialogue.factionName}} {{dialogue.npcName}} Dialogue Index">{{dialogue.factionName}} - {{dialogue.npcName}} {{storycount}}</a>
		</h1>
		<div id="storylinks">
			<a href="/story/{{story.prevstory}}" aria-label="View Previous Story">Prev</a>
			<a href="{{randomstory}}" aria-label="View a Random Story">Rand</a>
			<a href="/story/{{story.nextstory}}" aria-label="View Next Story">Next</a>
		</div>
	</div>
	{% endif %}
	</body>
</html>