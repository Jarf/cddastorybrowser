<div id="container" role="main">
	{% if indextype == "index" %}
	<h1>{{indexheading}}</h1>
	<p>Select a category to browse the entries within</p>
	<table id="categoryIndex" class="hover">
		<thead>
			<tr>
				<th>Name</th>
				<th>Type</th>
				<th>Entries</th>
			</tr>
		</thead>
		<tbody>
			{% for category in entries %}
			{% if category.storiesCount > 0 %}
			<tr>
				{% if category.type == "Snippets" %}
				<td><a href="/story/{{category.name}}">{{category.nameReadable}}</a></td>
				{% elseif category.type == "Dialogue" %}
				<td><a href="/dialogue/{{category.code}}">{{category.nameReadable}}</a></td>
				{% elseif category.type == "NPC" %}
				<td><a href="/dialogue/{{category.faction}}/{{category.code}}">{{category.name}}</a></td>
				{% endif %}
				<td>{{category.type}}</td>
				<td>{{category.storiesCount}}</td>
			</tr>
			{% endif %}
			{% endfor %}
		</tbody>
	</table>
	{% elseif indextype == "story" %}
	<h1>{{categorynamereadable}} Story Index</h1>
	<p>Select a story to view it</p>
	<table id="storyIndex" class="hover" role="main">
		<thead>
			<tr>
				<th>Entry</th>
			</tr>
		</thead>
		<tbody>
			{% for skey,story in entries %}
			<tr>
				<td><a href="/story/{{categoryname}}/{{skey + 1}}">{{story.story}}</a></td>
			</tr>
			{% endfor %}
		</tbody>
	</table>
	<a id="categoriesindex" href="/index/">Return to Categories Index</a>
	{% elseif indextype == "dialogue" %}
	<h1>{{categorynamereadable}} Index</h1>
	<p>Select an entry to view it</p>
	<table id="dialogueIndex" class="hover" role="main">
		<thead>
			<tr>
				<th>Entry</th>
			</tr>
		</thead>
		<tbody>
			{% for skey,story in entries %}
			<tr>
				<td><a href="/story/{{categoryname}}/{{skey + 1}}">{{story.story}}</a></td>
			</tr>
			{% endfor %}
		</tbody>
	</table>
	<a id="categoriesindex" href="/index/">Return to Categories Index</a>
	{% endif %}
</div>